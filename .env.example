# Environment Configuration for Fuel Route Optimizer

# Security & Debug
SECRET_KEY=replace-with-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Routing Providers (optional, defaults to public OSRM if omitted)
# ORS_API_KEY=your_free_openrouteservice_api_key_here
OSRM_URL=https://router.project-osrm.org
ROUTING_TIMEOUT=20

# Vehicle Defaults
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10
CORRIDOR_MILES=5
